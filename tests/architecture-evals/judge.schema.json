{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "positive",
          "negative_violations",
          "total",
          "fatal",
          "explanation"
        ],
        "properties": {
          "candidate": {
            "type": "string"
          },
          "positive": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          },
          "negative_violations": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "total": {
            "type": "integer",
            "minimum": -2,
            "maximum": 10
          },
          "fatal": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}
